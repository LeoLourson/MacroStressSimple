# msa.ps1 up однократно создаёт .env со случайным паролем PostgreSQL.
# Существующий .env сохраняется. Стенд использует базу msa_product.
POSTGRES_PASSWORD=CHANGE_ME
# При прямом запуске API задайте адрес базы через окружение.
# MSA_DATABASE_URL=postgresql://msa:password@127.0.0.1:5433/msa_product

# Выбор профиля: msa.ps1 up mock | local | deepseek.
# Настоящая LLM должна поддерживать вызовы инструментов и ответы в формате JSON.
# DEEPSEEK_API_KEY читается только из окружения процесса или пользователя.
# MSA_LLM_BASE_URL=http://127.0.0.1:1234/v1
# MSA_LLM_MODEL=
# MSA_LLM_JSON_MODE=json_schema
# MSA_LLM_TIMEOUT=300
# MSA_LLM_MAX_TOKENS=8192
